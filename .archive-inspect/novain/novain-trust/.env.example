# =============================================================================
# NOVAIN TRUST — environment template
# Copy to .env and fill values. Never commit real secrets.
# =============================================================================

DEBUG=false
ENVIRONMENT=development

# Generate:
#   openssl rand -hex 32   -> SECRET_KEY
#   openssl rand -hex 24   -> ADMIN_TOKEN
SECRET_KEY=
ADMIN_TOKEN=

# --- Database ---
# Development (optional):
# DATABASE_URL=sqlite+aiosqlite:///./novain_trust.db
#
# Production REQUIRED:
DATABASE_URL=postgresql+asyncpg://novain:CHANGE_ME@127.0.0.1:5432/novain_trust
POSTGRES_PASSWORD=CHANGE_ME

# Pool (production)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# API
RATE_LIMIT_PER_MINUTE=60
HTTP_TIMEOUT_SECONDS=10
MAX_REDIRECTS=5
BATCH_MAX_TARGETS=20
VERIFY_CACHE_TTL_SECONDS=300
WEB_CONCURRENCY=2
PORT=8000

# CORS: comma-separated origins; leave empty to disable browser CORS
CORS_ORIGINS=
ENABLE_DOCS=false

# Reputation (optional — missing keys => UNAVAILABLE, score contribution 0)
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
# Monetization
BILLING_ENFORCE=false
BILLING_REQUIRE_ACCOUNT=false
PAYMENT_PROVIDER=fake
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_MAX_AGE_SECONDS=300

